<?xml version="1.0" encoding="UTF-8"?>
<!--
    OWASP dependency-check suppression file.

    Add a <suppress> block here to silence a CONFIRMED false positive (a CVE that
    dependency-check maps to one of our dependencies but that does not actually apply).
    Always include a note explaining why, and prefer a specific <cve> over a broad regex.

    Example:
    <suppress>
        <notes>False positive: CVE is for the C library, not the Java binding we use.</notes>
        <packageUrl regex="true">^pkg:maven/com\.example/some-lib@.*$</packageUrl>
        <cve>CVE-2024-00000</cve>
    </suppress>
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
</suppressions>
