<?xml version="1.0" encoding="UTF-8"?>
<!--
    Test-only logging configuration (Logback auto-selects logback-test.xml over
    logback.xml on the test classpath). Mirrors the production appender + CRLF
    sanitizer, but pins the noisy framework/JavaMail loggers to WARN.

    Why: the suite shares one Surefire JVM, and a couple of Constitution-VII
    compliance tests raise the ROOT logger to DEBUG in @BeforeEach to capture
    application events. That leaks to every later test in the fork, which then
    logs Spring Security's per-request filter chain, Spring MVC dispatch, and
    JavaMail's provider-table dump (emitted on every MimeMessage build) at DEBUG.
    On a CI runner that volume of synchronous console I/O added many minutes.

    Setting these loggers EXPLICITLY to WARN makes them immune to the root=DEBUG
    leak (an explicit level wins over inherited root), while root itself stays
    INFO so application (com.aucontraire.gmailbuddy) logging is unchanged and the
    log-capture tests keep seeing exactly what they see today.
-->
<configuration>
    <conversionRule conversionWord="sanitizedMsg"
                    converterClass="com.aucontraire.gmailbuddy.util.CrlfSanitizingMessageConverter"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} - %sanitizedMsg%n</pattern>
        </encoder>
    </appender>

    <!-- JavaMail (Angus) provider-table dumps + JAF Mailcap lookups on every MimeMessage build -->
    <logger name="jakarta.mail" level="WARN"/>
    <logger name="com.sun.mail" level="WARN"/>
    <logger name="org.eclipse.angus.mail" level="WARN"/>
    <logger name="jakarta.activation" level="WARN"/>
    <logger name="org.eclipse.angus.activation" level="WARN"/>

    <!-- Spring Security filter-chain / SecurityContext + Spring MVC dispatch per request -->
    <logger name="org.springframework" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
